{
  "device": "ThorLabs Kiralux CS505MUP1",
  "commands": {
    "STOP":          {"request": {"template": "stop",   "regex": "stop$"},
                      "reply":   {"template": "ok\n",    "regex": ".*"}},
    "ARM":           {"request": {"template": "arm",    "regex": "arm$"},
                      "reply":   {"template": "ok\n",    "regex": ".*"}},
    "START":         {"request": {"template": "start",  "regex": "start$"},
                      "reply":   {"template": "ok\n",    "regex": ".*"}},

    "DISCOVER":      {"request": {"template": "discover", "regex": "discover$"},
                      "reply":   {"template": "{vocabulary}\n", "regex": "(.*)",
                                  "fields": {"vocabulary": "text"}}},

    "SERNUM":        {"request": {"template": "sernum", "regex": "sernum$"},
                      "reply":   {"template": "{serial}\n", "regex": "([0-9]+)",
                                  "fields": {"serial": "integer"}}},
    "MODEL":         {"request": {"template": "model", "regex": "model$"},
                      "reply":   {"template": "{model}\n", "regex": "(.+)",
                                  "fields": {"model": "text"}}},
    "IMAGE_WIDTH":   {"request": {"template": "image_width", "regex": "image_width$"},
                      "reply":   {"template": "{width}\n", "regex": "([0-9]+)",
                                  "fields": {"width": "integer"}}},
    "IMAGE_HEIGHT":  {"request": {"template": "image_height", "regex": "image_height$"},
                      "reply":   {"template": "{height}\n", "regex": "([0-9]+)",
                                  "fields": {"height": "integer"}}},
    "PIXEL_BIT_DEPTH": {"request": {"template": "pixel_bit_depth", "regex": "pixel_bit_depth$"},
                        "reply":   {"template": "{depth}\n", "regex": "([0-9]+)",
                                    "fields": {"depth": "integer"}}},
    "TEMPERATURE":   {"request": {"template": "temperature", "regex": "temperature$"},
                      "reply":   {"template": "{temperature}\n", "regex": "([0-9.-]+)",
                                  "fields": {"temperature": "float"}}},

    "EXP_GET":       {"request": {"template": "exp", "regex": "exp$"},
                      "reply":   {"template": "{exposure}\n", "regex": "([0-9]+)",
                                  "fields": {"exposure": "integer"}}},
    "EXP_SET":       {"request": {"template": "exp {exposure}", "regex": "exp ([0-9]+)$",
                                  "fields": {"exposure": "integer"}},
                      "reply":   {"template": "{exposure}\n", "regex": "([0-9]+)",
                                  "fields": {"exposure": "integer"}}},

    "GAIN_GET":      {"request": {"template": "gain", "regex": "gain$"},
                      "reply":   {"template": "{gain}\n", "regex": "([0-9]+)",
                                  "fields": {"gain": "integer"}}},
    "GAIN_SET":      {"request": {"template": "gain {gain}", "regex": "gain ([0-9]+)$",
                                  "fields": {"gain": "integer"}},
                      "reply":   {"template": "{gain}\n", "regex": "([0-9]+)",
                                  "fields": {"gain": "integer"}}},

    "BLKLVL_GET":    {"request": {"template": "blklvl", "regex": "blklvl$"},
                      "reply":   {"template": "{blacklevel}\n", "regex": "([0-9]+)",
                                  "fields": {"blacklevel": "integer"}}},
    "BLKLVL_SET":    {"request": {"template": "blklvl {blacklevel}", "regex": "blklvl ([0-9]+)$",
                                  "fields": {"blacklevel": "integer"}},
                      "reply":   {"template": "{blacklevel}\n", "regex": "([0-9]+)",
                                  "fields": {"blacklevel": "integer"}}},

    "HBIN_GET":      {"request": {"template": "hbin", "regex": "hbin$"},
                      "reply":   {"template": "{hbin}\n", "regex": "([0-9]+)",
                                  "fields": {"hbin": "integer"}}},
    "HBIN_SET":      {"request": {"template": "hbin {hbin}", "regex": "hbin ([0-9]+)$",
                                  "fields": {"hbin": "integer"}},
                      "reply":   {"template": "{hbin}\n", "regex": "([0-9]+)",
                                  "fields": {"hbin": "integer"}}},
    "VBIN_GET":      {"request": {"template": "vbin", "regex": "vbin$"},
                      "reply":   {"template": "{vbin}\n", "regex": "([0-9]+)",
                                  "fields": {"vbin": "integer"}}},
    "VBIN_SET":      {"request": {"template": "vbin {vbin}", "regex": "vbin ([0-9]+)$",
                                  "fields": {"vbin": "integer"}},
                      "reply":   {"template": "{vbin}\n", "regex": "([0-9]+)",
                                  "fields": {"vbin": "integer"}}},

    "ROI_GET":       {"request": {"template": "roi", "regex": "roi$"},
                      "reply":   {"template": "{left} {top} {right} {bottom}\n",
                                  "regex": "([0-9]+) ([0-9]+) ([0-9]+) ([0-9]+)",
                                  "fields": {"left": "integer", "top": "integer",
                                             "right": "integer", "bottom": "integer"}}},
    "ROI_SET":       {"request": {"template": "roi {left} {top} {right} {bottom}",
                                  "regex": "roi ([0-9]+) ([0-9]+) ([0-9]+) ([0-9]+)$",
                                  "fields": {"left": "integer", "top": "integer",
                                             "right": "integer", "bottom": "integer"}},
                      "reply":   {"template": "ok\n", "regex": ".*"}},

    "HWTRIG_SET":    {"request": {"template": "hwtrig {mode}", "regex": "hwtrig (\\w+)$",
                                  "fields": {"mode": "text"}},
                      "reply":   {"template": "ok\n", "regex": ".*"}},
    "NFRAMES_SET":   {"request": {"template": "nframes {nframes}", "regex": "nframes ([0-9]+)$",
                                  "fields": {"nframes": "integer"}},
                      "reply":   {"template": "{nframes}\n", "regex": "([0-9]+)",
                                  "fields": {"nframes": "integer"}}}
  }
}
